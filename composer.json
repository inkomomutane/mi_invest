{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "doctrine/dbal": "^4.3.1",
        "guzzlehttp/guzzle": "^7.9.3",
        "inertiajs/inertia-laravel": "^v2.0.4",
        "kalnoy/nestedset": "^v6.0.6",
        "laravel/breeze": "^v2.3.8",
        "laravel/framework": "^v12.21.0",
        "laravel/sanctum": "^v4.2.0",
        "laravel/tinker": "^v2.10.1",
        "masbug/flysystem-google-drive-ext": "^v2.4.1",
        "ralphjsmit/laravel-seo": "^1.7.0",
        "spatie/enum": "^3.13.0",
        "spatie/laravel-backup": "^9.3.4",
        "spatie/laravel-data": "^4.17.0",
        "spatie/laravel-medialibrary": "^11.13.0",
        "spatie/laravel-permission": "^6.21.0",
        "spatie/laravel-sitemap": "^7.3.6",
        "spatie/laravel-sluggable": "^3.7.5",
        "spatie/laravel-tags": "^4.10.0"
    },
    "require-dev": {
        "roave/security-advisories": "dev-latest",
        "barryvdh/laravel-debugbar": "^v3.16.0",
        "barryvdh/laravel-ide-helper": "^v3.6.0",
        "fakerphp/faker": "^v1.24.1",
        "laravel/pint": "^v1.24.0",
        "laravel/sail": "^v1.44.0",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^v8.8.2",
        "pestphp/pest": "^v3.8.2",
        "pestphp/pest-plugin-laravel": "^v3.2.0",
        "spatie/laravel-ignition": "^2.9.1",
        "spatie/laravel-web-tinker": "^1.10.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
